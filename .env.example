# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (optional — auto-detected from request headers if not set)
# Set this explicitly if auto-detection doesn't work for your deployment
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudflare R2
# Account ID from your Cloudflare Dashboard -> R2 Overview
R2_ACCOUNT_ID=your_account_id

# Generate under R2 -> "Manage R2 API Tokens" -> "Create API token" (Edit permission)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# The exact name of your bucket created in R2
R2_BUCKET_NAME=your_bucket_name

# LLM provider: OpenRouter (OpenAI-compatible).
# Used for resume generation, JD parsing, job URL extraction, translation,
# job feed enrichment, and (optionally) embeddings.
# Sign up at https://openrouter.ai and create a key.
OPENROUTER_API_KEY=your_openrouter_api_key

# Default model for chat completions (OpenRouter routes the slug to a provider).
# Examples: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: stronger model used specifically for resume rewriting
# OPENROUTER_REWRITE_MODEL=openai/gpt-4o

# Optional: embedding model (used for resume <-> JD similarity scoring)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: shown in OpenRouter analytics dashboard
# OPENROUTER_SITE_URL=https://your-domain.com
# OPENROUTER_APP_NAME=JobFlow AI

# Scraper microservice (Python FastAPI, see ./scraper-service)
# URL of the running scraper service (Docker default exposes 8000)
SCRAPER_SERVICE_URL=http://localhost:8000

# Shared secret between Next.js and the scraper service.
# Must match SCRAPER_INTERNAL_TOKEN in scraper-service/.env
# Generate with: openssl rand -hex 32
SCRAPER_INTERNAL_TOKEN=change-me
