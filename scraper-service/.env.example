# LLM provider: OpenRouter (OpenAI-compatible)
# Sign up at https://openrouter.ai and create a key.
OPENROUTER_API_KEY=sk-or-v1-...

# Default model used for classification + extraction.
# Examples: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: shown in OpenRouter analytics dashboard
# OPENROUTER_SITE_URL=https://your-domain.com
# OPENROUTER_APP_NAME=JobFlow AI Scraper

# Supabase service-role key (server-side only, NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared secret between Next.js and this service.
# Generate with: openssl rand -hex 32
SCRAPER_INTERNAL_TOKEN=change-me

# Optional tuning
SCRAPER_MAX_RESULTS_CAP=50
# Override the model for the scraper specifically (falls back to OPENROUTER_MODEL)
# SCRAPER_MODEL=openai/gpt-4o-mini
