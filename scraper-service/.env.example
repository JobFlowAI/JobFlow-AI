# OpenAI API key used for classification + extraction
OPENAI_API_KEY=sk-...

# Supabase service-role key (server-side only, NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared secret between Next.js and this service.
# Generate with: openssl rand -hex 32
SCRAPER_INTERNAL_TOKEN=change-me

# Optional tuning
SCRAPER_MAX_RESULTS_CAP=50
SCRAPER_OPENAI_MODEL=gpt-4o-mini
